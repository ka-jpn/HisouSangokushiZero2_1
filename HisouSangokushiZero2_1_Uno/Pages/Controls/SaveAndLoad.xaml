<?xml version="1.0" ?>
<UserControl 
  x:Class="HisouSangokushiZero2_1_Uno.Pages.SaveAndLoad"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HisouSangokushiZero2_1_Uno.Pages">
  <Grid x:Name="Content" Background="#EEE" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="Title" FontSize="40" LineHeight="46" HorizontalAlignment="Center"/>
    <ListView x:Name="Scroll" Grid.Row="1" MaxWidth="{x:Bind local:SaveAndLoad.scrollMaxWidth}" HorizontalAlignment="Stretch" ItemsSource="{x:Bind local:SaveAndLoad.saveSlotTexts,Mode=OneWay}">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:SaveSlotData">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Background="#FFF" Margin="2" PointerPressed="SaveSlot_PointerPressed">
              <TextBlock Text="{x:Bind local:SaveAndLoad.IndexToFileNo(SlotIndex)}" FontSize="36" LineHeight="42" Width="60" TextAlignment="Center" VerticalAlignment="Center"/>
              <Grid VerticalAlignment="Center">                
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Bind  MetaData.NowScenario}"/>
                    <StackPanel Width="10"/>
                    <TextBlock Text="{x:Bind MetaData.PlayCountry}"/>
                    <StackPanel Width="10"/>
                    <TextBlock Text="{x:Bind MetaData.PlayTurn}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Bind MetaData.TotalPlayTime}"/>
                    <StackPanel Width="10"/>
                    <TextBlock Text="{x:Bind MetaData.LastSaveDate}"/>
                    <StackPanel Width="10"/>
                    <TextBlock Text="{x:Bind MetaData.GameVersion}"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="{x:Bind SaveInfoText}" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
            <Button Grid.Column="1" Background="#FAA" VerticalAlignment="Stretch" Margin="2" Click="SaveSlot_DeleteButtonClick" Visibility="{x:Bind DeleteButtonVisibility}">
              <TextBlock Margin="8" Text="削除"/>
            </Button>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <Button x:Name="CloseButton" Grid.Row="2" MaxWidth="350" Height="60" Margin="5" HorizontalAlignment="Stretch">
      <TextBlock Text="閉じる"/>
    </Button>
    <Grid x:Name="GrayoutPanel" Grid.Row="0" Grid.RowSpan="3" Background="#CCCC" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
      <StackPanel x:Name="ConfirmPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFF" Padding="20"/>
    </Grid>
  </Grid>
</UserControl>