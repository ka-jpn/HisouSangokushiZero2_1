<?xml version="1.0" ?>
<UserControl 
  x:Class="HisouSangokushiZero2_1_Uno.Pages.FillDreamCondition"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HisouSangokushiZero2_1_Uno.Pages">
  <UserControl.Resources>
    <DataTemplate x:Key="FillDreamConditionItemsRepeater" x:DataType="local:FillDreamConditionData">
      <Grid Background="{x:Bind Brush}" HorizontalAlignment="Stretch" MinHeight="25" Padding="0,0,0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="50"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{x:Bind Country}" TextAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1"  VerticalAlignment="Center">
          <TextBlock Text="{x:Bind FillDreamConditionText}" TextAlignment="Start" Padding="5,0,0,0"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid x:Name="ContentPanel" Padding="2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
        <TextBlock Text="表示シナリオ：" VerticalAlignment="Center"/>
        <ComboBox Width="200" Height="40" x:Name="ScenarioComboBox"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" MaxWidth="{x:Bind local:FillDreamCondition.itemsRepeaterWidth}" Background="#EEE">
        <TextBlock Text="陣営" TextAlignment="Center" Width="50"/>
        <TextBlock Text="悲願" MaxWidth="700" Padding="5,0,0,0" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer Grid.Row="1" x:Name="FillDreamConditionScroll" MaxWidth="{x:Bind local:FillDreamCondition.itemsRepeaterWidth}">
      <ItemsRepeater x:Name="FillDreamConditionItemsRepeater" ItemTemplate="{StaticResource FillDreamConditionItemsRepeater}" Background="#CCC"/>
    </ScrollViewer>
  </Grid>
</UserControl>