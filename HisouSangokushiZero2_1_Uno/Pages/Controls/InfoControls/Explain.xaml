<?xml version="1.0" ?>
<UserControl
  x:Class="HisouSangokushiZero2_1_Uno.Pages.Explain"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <StackPanel x:Name="ContentPanel" Padding="2">
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="勝利・敗北について" HorizontalAlignment="Center"/>
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="勝利条件：陣営勝利条件を一番乗りで達成(達成勝利) or ゲーム終了年春まで存続(存続勝利)"/>
        <TextBlock Text="敗北条件：プレイヤー勢力領土全失陥(滅亡敗北) or 陣営勝利条件をCPUに先に達成される(他陣営達成勝利敗北)"/>
      </StackPanel>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="陣営の軍議・行動フェイズ順について" HorizontalAlignment="Center"/>
      <TextBlock Text="フェイズは並行して実行されます" HorizontalAlignment="Center"/>
      <TextBlock Text="ただし攻撃先地域が競合した場合は総内政値が小さい陣営から戦闘権を得ます" HorizontalAlignment="Center"/>
      <TextBlock Text="NPC勢力は他の勢力のフェイズを参照せずにフェイズ内容を決定し、プレイヤーを特別視しません" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="軍議フェイズについて" HorizontalAlignment="Center"/>
      <TextBlock Text="人物の配置移動と侵攻の指令ができます、フェイズ内であれば指令しなおせます" HorizontalAlignment="Center"/>
      <TextBlock Text="人物の配置は首都に接続している自領土内で移動できます、距離の制限はありません" HorizontalAlignment="Center"/>
      <TextBlock Text="侵攻の指令ができるのは首都に接続している自領土に隣接している他国の地域および自治領です" HorizontalAlignment="Center"/>
      <TextBlock Text="「軍議終了」ボタンをクリックで戦略フェイズを確定して進行します" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="行動フェイズについて" HorizontalAlignment="Center"/>
      <TextBlock Text="軍議フェイズの侵攻指令が実際に行われます" HorizontalAlignment="Center"/>
      <TextBlock Text="それぞれの陣営の侵攻状態がマップにアニメーションされます" HorizontalAlignment="Center"/>
      <TextBlock Text="「確認」ボタンをクリックで行動フェイズの表示を終えます" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="侵攻の指令について" HorizontalAlignment="Center"/>
      <TextBlock Text="[国力回復時]" HorizontalAlignment="Center"/>
      <TextBlock Text="侵攻指令ができません、防衛専念状態にもなりません" HorizontalAlignment="Center"/>
      <TextBlock Text="[行動可能時]" HorizontalAlignment="Center"/>
      <TextBlock Text="隣接他国領土をクリック：「資金が足りればその地域に侵攻、足りなければ防衛専念」を指令にします" HorizontalAlignment="Center"/>
      <TextBlock Text="自国領土をクリック：「防衛専念」を指令にします" HorizontalAlignment="Center"/>
      <TextBlock Text="※防衛専念：防御ランクに+1の補正が付きます" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="人物の配置について" HorizontalAlignment="Center"/>
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="中枢：筆頭と次席の能力により確率で自動で登用が行われます"/>
        <TextBlock Text="内政：筆頭と次席の能力により内政効率が上がり、税収と内政値上昇に寄与します、地域の内政担当にもできます"/>
        <TextBlock Text="防衛：筆頭と次席の能力により首都の防衛に能力を発揮します、地域の防衛担当にもできます"/>
        <TextBlock Text="侵攻：筆頭と次席の能力により侵攻時に能力を発揮し、相手の防衛官との能力差による優劣が乱数による判定に影響します"/>
      </StackPanel>
      <TextBlock Text="筆頭と次席以外の中央のポストはストック扱いで能力の発揮はされません" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="首都について" HorizontalAlignment="Center"/>
      <TextBlock Text="首都は、陣営中央がある場所で、陣営の各種ポストの人物は首都に在籍し、出撃の起点になります" HorizontalAlignment="Center"/>
      <TextBlock Text="首都から接続されている領土内で内政値が首都より高いところがあれば、そこに移転されます" HorizontalAlignment="Center"/>
      <TextBlock Text="首都が陥落した際は、首都から接続されている領土内で内政値が一番高い土地に移転されます" HorizontalAlignment="Center"/>
      <TextBlock Text="もし陥落の際に首都から接続されている領土がなかった場合は、それ以外の領土で内政値が一番高い土地に移転されます" HorizontalAlignment="Center"/>
      <TextBlock Text="首都の内政値は1.5倍の値として総内政値に寄与されます" HorizontalAlignment="Center"/>
      <TextBlock Text="首都を攻められると首都エリアの地域防衛担当がまず防衛の戦闘、敗れれば首都の防衛ポストの人物が迎撃します" HorizontalAlignment="Center"/>
      <TextBlock Text="首都陥落時には中央所属(それぞれの地域にいる防衛担当・内政担当以外)の人物がそれぞれ50%の確率で戦死します" HorizontalAlignment="Center"/>
      <TextBlock Text="首都から接続されていない地域は、防衛担当と内政担当を異動させることができません" HorizontalAlignment="Center"/>
      <TextBlock Text="侵攻は、首都から接続されている領土に隣接している他陣営地域のみ可能です" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="戦闘の判定について" HorizontalAlignment="Center"/>
      <TextBlock Text="領土の防衛は領土エリア毎の防衛担当が行います" HorizontalAlignment="Center"/>
      <TextBlock Text="侵攻は首都の侵攻ポストの筆頭と次席、首都防衛は首都の防衛ポストの筆頭と次席が行います" HorizontalAlignment="Center"/>
      <TextBlock Text="領土の防衛担当はランクそのまま、首都のポストは(筆頭ランク+次席ランク/2)が合計のランクになります" HorizontalAlignment="Center"/>
      <TextBlock Text="戦闘時のランクおよび乱数(0以上~100未満)と結果" HorizontalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2.5,0,5">
        <StackPanel>
          <TextBlock Text="攻撃側-防御側" HorizontalAlignment="Center" Height="15"/>
          <Grid x:Name="BattleExplainCaption" Height="150">
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                <TextBlock Text="攻撃側大勝" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <Grid x:Name="AttackCrushFillColor" Width="10" Height="10" Margin="2"/>
                <Grid x:Name="AttackCrushEdgeColor" Width="10" Height="10" Margin="2"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                <TextBlock Text="攻撃側辛勝" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <Grid x:Name="AttackWinFillColor" Width="10" Height="10" Margin="2"/>
                <Grid x:Name="AttackWinEdgeColor" Width="10" Height="10" Margin="2"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                <TextBlock Text="攻撃側惜敗" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <Grid x:Name="AttackLoseFillColor" Width="10" Height="10" Margin="2"/>
                <Grid x:Name="AttackLoseEdgeColor" Width="10" Height="10" Margin="2"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                <TextBlock Text="攻撃側大敗" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <Grid x:Name="AttackRoutFillColor" Width="10" Height="10" Margin="2"/>
                <Grid x:Name="AttackRoutEdgeColor" Width="10" Height="10" Margin="2"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>
        <StackPanel Padding="5,0">
          <Canvas x:Name="AttackRankDiffTextPanel" Margin="0,6.25,0,15"/>
          <Grid x:Name="AttackJudgeExplainPanel" MaxWidth="650" Height="400">
            <Polygon x:Name="AttackCrushShape"/>
            <Polygon x:Name="AttackWinShape"/>
            <Polygon x:Name="AttackLoseShape"/>
            <Polygon x:Name="AttackRoutShape"/>
            <Canvas x:Name="AttackJudgeThresholdPointPanel"/>
          </Grid>
        </StackPanel>
      </StackPanel>
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="攻撃側大勝 … 防御側陥落、防御側将確率25%で戦死"/>
        <TextBlock Text="攻撃側辛勝 … 防御側陥落、攻撃側次ターン国力回復(休み)"/>
        <TextBlock Text="攻撃側惜敗 … 防御側撃退成功、攻撃側次ターン国力回復(休み)"/>
        <TextBlock Text="攻撃側大敗 … 防御側撃退成功、攻撃側次3ターン国力回復(休み)、攻撃側将それぞれ確率25%で戦死"/>
      </StackPanel>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="人物の登場期間について" HorizontalAlignment="Center"/>
      <TextBlock Text="人物は首都中枢担当に登用されると陣営に加わります" HorizontalAlignment="Center"/>
      <TextBlock Text="人物に設定された没年以降に生存していたら確率で死去し陣営から抜けます" HorizontalAlignment="Center"/>
      <TextBlock Text="没年前にも防衛失敗や攻撃失敗で戦死することがあります" HorizontalAlignment="Center"/>
      <TextBlock Text="ターンごとの死去判定の確率" HorizontalAlignment="Center"/>
      <TextBlock Text="人物に設定された死去年 春 ・・・ (1/40)*(年齢/60)" HorizontalAlignment="Center"/>
      <TextBlock Text="人物に設定された死去年 夏 ・・・ (1/39)*(年齢/60)" HorizontalAlignment="Center"/>
      <TextBlock Text="人物に設定された死去年 秋 ・・・ (1/38)*(年齢/60)" HorizontalAlignment="Center"/>
      <TextBlock Text="人物に設定された死去年 冬 ・・・ (1/37)*(年齢/60)" HorizontalAlignment="Center"/>
      <TextBlock Text="人物に設定された死去年+1年 春 ・・・ (1/36)*(年齢/60)" HorizontalAlignment="Center"/>
      <TextBlock Text="・" HorizontalAlignment="Center"/>
      <TextBlock Text="・" HorizontalAlignment="Center"/>
      <TextBlock Text="人物に設定された死去年+9 春 ・・・ (1/4)*(年齢/60)" HorizontalAlignment="Center"/>
      <TextBlock Text="人物に設定された死去年+9 夏 ・・・ (1/3)*(年齢/60)" HorizontalAlignment="Center"/>
      <TextBlock Text="人物に設定された死去年+9 秋 ・・・ (1/2)*(年齢/60)" HorizontalAlignment="Center"/>
      <TextBlock Text="人物に設定された死去年+9 冬 ・・・ (1/1)*(年齢/60)" HorizontalAlignment="Center"/>
      <TextBlock Text="人物に設定された死去年+10年 ・・・ 1 (必ず死去)" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="首都中枢担当人物による登用について" HorizontalAlignment="Center"/>
      <TextBlock Text="陣営毎に登場が設定された人物がいればその人物の登用、いなければ無名人物の登用が行われます" HorizontalAlignment="Center"/>
      <TextBlock Text="登場が設定された人物は秋ターンに担当人物の能力に関係なく確実に登用され、陣営に追加されます" HorizontalAlignment="Center"/>
      <TextBlock Text="無名人物は筆頭と次席のランクにより確率で毎ターンの始めに成功判定され、陣営に追加されます" HorizontalAlignment="Center"/>
      <TextBlock Text="基本的に無名人物はランク1ですが、まれにランク2が出現することがあります" HorizontalAlignment="Center"/>
      <TextBlock Text="登用された人物が配置できるポストがない場合、配置できるようになるまで人物駒の出現は延期されます" HorizontalAlignment="Center"/>
      <TextBlock Text="※無名人物の登用確率：季節毎に、(筆頭ランク+次席ランク/2+1)/30" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="首都内政担当人物による内政について" HorizontalAlignment="Center"/>
      <TextBlock Text="筆頭と次席のランクにより陣営の内政力が上乗せされます" HorizontalAlignment="Center"/>
      <TextBlock Text="陣営の内政力は総内政値による軍資金税収と地域毎の内政上昇値に影響します" HorizontalAlignment="Center"/>
      <TextBlock Text="※陣営の内政力：(筆頭ランク+次席ランク/2)/5+1" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="地域担当人物による内政について" HorizontalAlignment="Center"/>
      <TextBlock Text="地域毎に内政担当の人物ランクによって地域の内政値が上昇します" HorizontalAlignment="Center"/>
      <TextBlock Text="内政値は地域毎の内政上限値に近づくごとに伸びが悪くなります" HorizontalAlignment="Center"/>
      <TextBlock Text="地域毎の内政上限値は季節毎に少しずつ伸びていきます" HorizontalAlignment="Center"/>
      <TextBlock Text="内政上昇値は中央ポストの内政担当の筆頭と次席の人物ランクも影響します" HorizontalAlignment="Center"/>
      <TextBlock Text="※内政上昇値：季節毎に、対象地域の内政担当の人物ランク×陣営の内政力×(1-内政値/内政上限値)/内政難度" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="内政難度について" HorizontalAlignment="Center"/>
      <TextBlock Text="領土の広さに伴って内政難度が増えます" HorizontalAlignment="Center"/>
      <TextBlock Text="内政難度が上がると、収入効率が減少します" HorizontalAlignment="Center"/>
      <TextBlock Text="ただし、収入効率は陣営の内政力も影響します" HorizontalAlignment="Center"/>
      <TextBlock Text="※内政難度：領土エリア数^0.5" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="収支計算について" HorizontalAlignment="Center"/>
      <TextBlock Text="ターン毎に、収入-支出が資金に合計されます" HorizontalAlignment="Center"/>
      <TextBlock Text="収支や資金がマイナスになってもペナルティはありません" HorizontalAlignment="Center"/>
      <TextBlock Text="収入には軍資金税収と資本注入、支出には民政費と内政費と俸禄費があります" HorizontalAlignment="Center"/>
      <TextBlock Text="軍資金税収は領土からの収入です、内政値に応じて収入がありますが内政難度によるデバフがあります" HorizontalAlignment="Center"/>
      <TextBlock Text="資本注入は陣営トップが陣営に入れる資金で、領土数が少ない時は頑張り、多くなると怠けます" HorizontalAlignment="Center"/>
      <TextBlock Text="民政費は民衆還元分とその政治コストです、内政難度や総内政値が増えると増え、陣営の内政力が増えると減ります" HorizontalAlignment="Center"/>
      <TextBlock Text="内政費は地域内政担当の人物が内政をする際のコストです、人物ランクが高いと内政上昇値も増えますがこれも増えます" HorizontalAlignment="Center"/>
      <TextBlock Text="俸禄費は陣営所属の人物に支払われる俸禄で、人物ランク毎に所属人物に俸禄があります、担当ポストによって増えます" HorizontalAlignment="Center"/>
      <TextBlock Text="※軍資金税収：季節毎に、総内政値×内政力/内政難度" HorizontalAlignment="Center"/>
      <TextBlock Text="※資本注入：季節毎に、10/領土数" HorizontalAlignment="Center"/>
      <TextBlock Text="※民政費：季節毎に、(1-0.9^内政難度)×総内政値/内政力" HorizontalAlignment="Center"/>
      <TextBlock Text="※内政費：季節毎に、地域内政担当の人物ランク合計×2" HorizontalAlignment="Center"/>
      <TextBlock Text="※俸禄費：季節毎に、陣営所属の人物ランク合計×0.1+(筆頭が1、次席が0.5、地域内政担当と地域防衛担当が0.5)" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="侵攻出撃費用について" HorizontalAlignment="Center"/>
      <TextBlock Text="首都の攻撃ポストの筆頭と次席のランクにより出撃費用が算定され、資金が足りている時のみ侵攻できます" HorizontalAlignment="Center"/>
      <TextBlock Text="資金が足りていない場合は実行されませんがペナルティはなく、防衛専念と同じ扱いになります" HorizontalAlignment="Center"/>
      <TextBlock Text="※出撃費用：(筆頭ランク+次席ランク/2+1)×50" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="内政値・内政上限値について" HorizontalAlignment="Center"/>
      <TextBlock Text="領土に「(内政値)/(内政上限値)」表記があり、小数点以下切捨てで表記されます" HorizontalAlignment="Center"/>
      <TextBlock Text="内政上限値は毎ターン少量増加し、内政値が上回ることはできません" HorizontalAlignment="Center"/>
      <TextBlock Text="他のエリアに侵攻する際に徴兵弊害として自領土の各エリアの内政値が少し低下します" HorizontalAlignment="Center"/>
      <TextBlock Text="侵攻され領有が変わると荒廃して、内政値がかなり減ります、内政上限値も減ります" HorizontalAlignment="Center"/>
      <TextBlock Text="防衛成功した場合は、領有が変わるよりは少ないですが、損害として内政値がいくらか減ります" HorizontalAlignment="Center"/>
      <TextBlock Text="※内政値＆内政上限値精度：表記は小数点以下切捨て、内部では小数点以下4桁まで計算" HorizontalAlignment="Center"/>
      <TextBlock Text="※内政上限値：季節毎に、+0.1%+0.01" HorizontalAlignment="Center"/>
      <TextBlock Text="※徴兵弊害：自領土の各エリアの内政値が1%低下" HorizontalAlignment="Center"/>
      <TextBlock Text="※荒廃：内政値が90%に＆内政上限値が95%に" HorizontalAlignment="Center"/>
      <TextBlock Text="※損害：内政値が95%に(内政上限値は変更なし)" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="中華領域について" HorizontalAlignment="Center"/>
      <TextBlock Text="人物配置枠が黄色っぽくなっているのが中華領域です" HorizontalAlignment="Center"/>
      <TextBlock Text="陣営により勝利条件に含まれており、勝利条件に影響します" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="助力について" HorizontalAlignment="Center"/>
      <TextBlock Text="人物を元々の役割でない役割に割り当てることができます" HorizontalAlignment="Center"/>
      <TextBlock Text="ただし、他の役割に助力する際は発揮するランクが1つ下がります" HorizontalAlignment="Center"/>
      <TextBlock Text="元々の役割に戻すと発揮するランクも戻ります" HorizontalAlignment="Center"/>
      <StackPanel Height="5"/>
      <TextBlock FontFamily="{StaticResource SourceHanSansJPBold}" Text="道路について" HorizontalAlignment="Center"/>
      <TextBlock Text="地域同士が道路で接続されている場合のみ隣接となります" HorizontalAlignment="Center"/>
      <TextBlock Text="首都から自領土の中だけで接続が辿れる範囲のみ、人物の配置換えと行軍ができます" HorizontalAlignment="Center"/>
      <TextBlock Text="※種類として陸路/水路、３段階の太さがありますが、見た目の違いのみ" HorizontalAlignment="Center"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>