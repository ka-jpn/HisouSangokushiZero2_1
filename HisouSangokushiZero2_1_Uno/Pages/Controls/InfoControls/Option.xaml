<?xml version="1.0" ?>
<UserControl 
  x:Class="HisouSangokushiZero2_1_Uno.Pages.Option"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:data="using:HisouSangokushiZero2_1_Uno.Data">
  <ScrollViewer x:Name="Scroll" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <StackPanel x:Name="ContentPanel" Padding="2">
      <StackPanel Height="10"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock x:Name="MapZoomCaption" Text="マップスケール" VerticalAlignment="Center" TextAlignment="Center" Width="150"/>
        <Button x:Name="ZoomInMapButton" Width="150" Height="50" Margin="5,0" HorizontalAlignment="Center" Background="#AFFF" BorderBrush="Black">
          <TextBlock Text="拡大"/>
        </Button>
        <Button x:Name="ZoomOutMapButton" Width="150" Height="50" Margin="5,0" HorizontalAlignment="Center" Background="#AFFF" BorderBrush="Black">
          <TextBlock Text="縮小"/>
        </Button>
      </StackPanel>
      <StackPanel Height="20"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock x:Name="InfoTextZoomCaption" Text="情報/ログ テキスト" VerticalAlignment="Center" TextAlignment="Center" Width="150"/>
        <Button x:Name="ZoomInInfoTextButton" Width="150" Height="50" Margin="5,0" HorizontalAlignment="Center" Background="#AFFF" BorderBrush="Black">
          <TextBlock Text="拡大"/>
        </Button>
        <Button x:Name="ZoomOutInfoTextButton" Width="150" Height="50" Margin="5,0" HorizontalAlignment="Center" Background="#AFFF" BorderBrush="Black">
          <TextBlock Text="縮小"/>
        </Button>
      </StackPanel>
      <StackPanel Height="20"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock x:Name="ViewModeCaption" Text="現在のビュー：" VerticalAlignment="Center"/>
        <TextBlock x:Name="ViewModeText" VerticalAlignment="Center" Width="65"/>
        <Button x:Name="InnerSwitchViewModeButton" Width="250" Height="40" Background="#AFFF" BorderBrush="Black">
          <TextBlock Text="モードを切り替える"/>
        </Button>
      </StackPanel>
      <StackPanel Height="20"/>
      <Button x:Name="SaveGameButton" Width="350" Height="50" HorizontalAlignment="Center" Background="#AFFF" BorderBrush="Black">
        <TextBlock Text="セーブ"/>
      </Button>
      <StackPanel Height="20"/>
      <Button x:Name="LoadGameButton" Width="350" Height="50" HorizontalAlignment="Center" Background="#AFFF" BorderBrush="Black">
        <TextBlock Text="ロード"/>
      </Button>
      <StackPanel Height="20"/>
      <Button x:Name="InitGameButton" Width="350" Height="50" HorizontalAlignment="Center" Background="#AFFF" BorderBrush="Black">
        <TextBlock Text="ゲームを初期化"/>
      </Button>
      <StackPanel Height="20"/>
      <Button x:Name="BackTitleButton" Width="350" Height="50" HorizontalAlignment="Center" Background="#AFFF" BorderBrush="Black">
        <TextBlock Text="タイトルに戻る"/>
      </Button>
      <StackPanel Height="10"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>